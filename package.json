{
  "name": "vite-electron-dns",
  "version": "1.0.0",
  "private": true,
  "description": "DNS and DoH benchmarking tool",
  "author": "Florencea Bear",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "agent:lint": "npm run agent:lint:eslint && npm run agent:lint:tailwind",
    "agent:lint:ci": "actionlint --no-color",
    "agent:lint:eslint": "eslint --no-color --no-inline-config --max-warnings 0",
    "agent:lint:fix": "eslint --fix && node scripts/lint-tailwind.ts --fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:test:e2e": "npm run test:smoke",
    "agent:test:unit": "vitest run --reporter=tap-flat --no-color",
    "agent:typecheck": "tsc -b --pretty false",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build && npm run pack && npm run agent:test:e2e",
    "agent:verify:inner": "npm run agent:typecheck && npm run agent:lint",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:linux": "npm run build && electron-builder -c electron-builder-config.ts --linux --publish never",
    "build:mac": "npm run build && electron-builder -c electron-builder-config.ts --mac --publish never",
    "build:main": "vite build --ssr src/main/index.ts --outDir dist/main",
    "build:preload": "vite build --mode preload",
    "build:renderer": "vite build",
    "build:win": "npm run build && electron-builder -c electron-builder-config.ts --win --x64 --arm64 --publish never",
    "check": "npm run typecheck && npm run lint && npm run lint:tailwind && npm run format:check && npm run check:deadcode && npm run test && npm run build && npm run pack",
    "check:deadcode": "knip",
    "dev": "node scripts/dev.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "pack": "electron-builder -c electron-builder-config.ts --dir --publish never",
    "setup": "install-electron && electron-builder install-app-deps",
    "test": "vitest run",
    "test:e2e": "npm run test:smoke",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer",
    "test:setup": "playwright install chromium",
    "test:smoke": "node scripts/smoke-test.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@adobe/react-spectrum": "3.47.5",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "knip": "6.37.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0",
    "vscode-languageserver-protocol": "3.18.3"
  },
  "engines": {
    "node": "24.21.0"
  },
  "knip": {
    "entry": [
      "src/main/index.ts",
      "src/preload/index.ts",
      "electron-builder-config.ts"
    ],
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
