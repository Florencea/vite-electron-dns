{
  "name": "vite-electron-dns",
  "version": "1.0.0",
  "description": "An Electron application for DNS and DNS-over-HTTPS (DoH) management, built with Vite and React.",
  "keywords": [
    "dns",
    "dns-over-https",
    "doh",
    "electron",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/Florencea/vite-electron-dns",
  "author": "Florencea Bear",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:linux": "npm run build && electron-builder -c electron-builder-config.ts --linux",
    "build:mac": "npm run build && electron-builder -c electron-builder-config.ts --mac",
    "build:win": "npm run build && electron-builder -c electron-builder-config.ts --win --x64 --arm64",
    "dev": "electron-vite dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "setup": "install-electron && electron-builder install-app-deps",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@adobe/react-spectrum": "3.47.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "17.4.2",
    "electron": "44.2.0",
    "electron-builder": "27.0.0-alpha.8",
    "electron-vite": "6.0.0-beta.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "rimraf": "6.0.0"
  },
  "engines": {
    "node": "24.20.0"
  }
}
